{
  "name": "@0dep/amqp-emulator",
  "version": "0.1.0",
  "description": "AMQP 0-9-1 broker emulator for tests, listens on a real TCP port and speaks the wire protocol",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run dist && npm run tsc && npm run test:md",
    "lint": "eslint . --cache && prettier . --check --cache",
    "generate": "node scripts/generate-defs.js > src/defs.js && prettier --write src/defs.js",
    "dist": "dts-buddy",
    "tsc": "tsc -p test",
    "prepack": "npm run dist",
    "cov:html": "c8 -n src -r html -r text mocha",
    "test:lcov": "c8 -n src -r lcov -r text mocha",
    "test:md": "texample ./README.md"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "amqp",
    "rabbitmq",
    "emulator",
    "mock",
    "fake",
    "broker",
    "test"
  ],
  "author": {
    "name": "Zerodep AB",
    "url": "https://0dep.se"
  },
  "license": "MIT",
  "dependencies": {
    "smap": "^0.2.0",
    "smqp": "^13.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "amqplib": "^2.0.1",
    "c8": "^12.0.0",
    "chai": "^6.2.1",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.3.0",
    "globals": "^17.0.0",
    "mocha": "^11.8.0",
    "mocha-cakes-2": "^3.3.0",
    "prettier": "^3.5.0",
    "texample": "^1.0.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "src/",
    "types/"
  ],
  "types": "./types/index.d.ts"
}

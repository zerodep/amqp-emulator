{
  "name": "amqp-emulator",
  "version": "0.1.0",
  "description": "AMQP 0-9-1 and 1.0 broker emulator for tests, listens on a real TCP port and speaks both wire protocols",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerodep/amqp-emulator.git"
  },
  "bugs": {
    "url": "https://github.com/zerodep/amqp-emulator/issues"
  },
  "author": {
    "name": "Zerodep AB",
    "url": "https://0dep.se"
  },
  "homepage": "https://0dep.se",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run dist && npm run tsc && npm run test:md",
    "lint": "eslint . --cache && prettier . --check --cache",
    "generate:amqp09": "node scripts/generate-amqp09-defs.js > src/amqp09/defs.js && prettier --write src/amqp09/defs.js",
    "dist": "dts-buddy",
    "tsc": "tsc -p test",
    "prepack": "npm run dist",
    "cov:html": "c8 -n src -r html -r text mocha",
    "test:lcov": "c8 -n src -r lcov -r text mocha",
    "test:md": "texample ./README.md",
    "generate:amqp10": "node scripts/generate-amqp10-defs.js > src/amqp10/defs.js && prettier --write src/amqp10/defs.js"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "amqp",
    "amqp 1.0",
    "rabbitmq",
    "rhea",
    "amqplib",
    "emulator",
    "mock",
    "fake",
    "broker",
    "test"
  ],
  "license": "MIT",
  "dependencies": {
    "smqp": "^14.0.0"
  },
  "devDependencies": {
    "@azure/service-bus": "^7.9.5",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "amqplib": "^2.0.1",
    "c8": "^12.0.0",
    "chai": "^6.2.1",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.3.0",
    "globals": "^17.0.0",
    "mocha": "^11.8.0",
    "mocha-cakes-2": "^3.3.0",
    "nock": "^14.0.17",
    "prettier": "^3.5.0",
    "rhea": "^3.0.5",
    "texample": "^1.0.2",
    "typescript": "^6.0.3"
  },
  "files": [
    "src/",
    "types/index.d.ts*",
    "NOTICE"
  ],
  "types": "./types/index.d.ts"
}
